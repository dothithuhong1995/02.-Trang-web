# ==== CẤU HÌNH SUPABASE ====
# Lấy 2 giá trị này trong: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Khóa service_role (chỉ dùng phía máy chủ, KHÔNG chia sẻ, KHÔNG có tiền tố NEXT_PUBLIC)
# Lấy trong: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email dùng làm tài khoản Admin (đăng nhập quản trị)
# Tạo tài khoản này ở bước hướng dẫn triển khai.
NEXT_PUBLIC_ADMIN_EMAIL=admin@truong-nguyenvietxuan.edu.vn
